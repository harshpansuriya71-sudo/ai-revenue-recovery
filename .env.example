# ---- AI (required) -------------------------------------------------------
# Free key from https://aistudio.google.com/apikey — no credit card needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ---- Razorpay Test Mode (required for live payment links) ----------------
# dashboard.razorpay.com → switch to TEST MODE → Settings → API Keys
# Without these the agent still runs; payment links are marked "simulated".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Any random string. Used to HMAC-sign simulated webhook payloads so the
# webhook route's real signature verification is exercised end to end.
RAZORPAY_WEBHOOK_SECRET=rebound_local_webhook_secret

# ---- Local ---------------------------------------------------------------
APP_URL=http://localhost:3000
